{
  "expo": {
    "scheme": "kanjipro",
    "name": "Kanji Pro",
    "slug": "Kanji-Pro",
    "version": "1.2.1",
    "orientation": "portrait",
    "icon": "./assets/MyAssets/blueLogo.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.github.kairosakil.kanjipro"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/MyAssets/blueLogo.png",
        "backgroundColor": "#000000"
      },
      "package": "io.github.kairosakil.kanjipro",
      "versionCode": 4
    },
    "web": {
      "favicon": "./assets/MyAssets/blueLogo.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/withReleaseSigning",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-notifications",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/MyAssets/blueLogo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a",
              "armeabi-v7a"
            ]
          }
        }
      ],
      "@react-native-vector-icons/ionicons"
    ]
  }
}
